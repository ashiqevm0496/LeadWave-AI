{
  "name": "ui-screenshot-react-tailwind",
  "displayName": "UI Screenshot to React + Tailwind",
  "description": "Paste a UI screenshot into VS Code and generate React + Tailwind component scaffolds with heuristic component detection and live preview.",
  "version": "0.0.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "vscode",
    "react",
    "tailwind",
    "screenshot",
    "ui"
  ],
  "activationEvents": [
    "onCommand:uiScreenshotReact.openGenerator"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "uiScreenshotReact.openGenerator",
        "title": "UI Screenshot: Open Generator",
        "category": "UI Screenshot"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.4"
  }
}
